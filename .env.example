# Copy this file to `.env` and fill in real values.
#   cp .env.example .env

# ── Database (PostgreSQL) ────────────────────────────────────
# Local embedded Postgres (npm run dev:db) uses port 5433:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecobela?schema=public"
# Production example (Neon / Supabase / RDS):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# ── Auth ─────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# ── Bootstrap admin (used only by `npm run admin:create`) ────
ADMIN_NAME="Eco Bela Admin"
ADMIN_EMAIL="admin@ecobela.com"
ADMIN_PASSWORD="change-this-password"

# ── Storage (Cloudinary) ─────────────────────────────────────
# Leave empty to use the local disk uploader during development.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="ecobela/products"

# ── Public config ────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Eco Bela"
